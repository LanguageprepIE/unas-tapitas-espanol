  {
    "id": "F01",
    "text": "¿Cuándo es tu cumpleaños?",
    "voice": "L"
  },
  {
    "id": "F02",
    "text": "Mi cumpleaños es el uno de abril.",
    "voice": "J"
  },
  {
    "id": "F03",
    "text": "Mi cumpleaños es el treinta y uno de octubre.",
    "voice": "L"
  },
  {
    "id": "F04",
    "text": "¿Cuándo es su cumpleaños?",
    "voice": "L"
  },
  {
    "id": "F05",
    "text": "Su cumpleaños es el veintidós de marzo.",
    "voice": "J"
  },
  {
    "id": "F06",
    "text": "¡Feliz cumpleaños!",
    "voice": "L"
  },
  {
    "id": "D01",
    "text": "¿Cómo eres?",
    "voice": "J"
  },
  {
    "id": "D02",
    "text": "Soy simpática.",
    "voice": "L"
  },
  {
    "id": "D03",
    "text": "¿Cómo es Leo?",
    "voice": "L"
  },
  {
    "id": "D04",
    "text": "Leo es simpático.",
    "voice": "J"
  },
  {
    "id": "D05",
    "text": "Tengo el pelo corto.",
    "voice": "L"
  },
  {
    "id": "D06",
    "text": "Tiene el pelo largo.",
    "voice": "J"
  },
  {
    "id": "D07",
    "text": "Llevo gafas.",
    "voice": "L"
  },
  {
    "id": "D08",
    "text": "Lleva gafas.",
    "voice": "L"
  },
  {
    "id": "D09",
    "text": "Ana es amable. Hoy está nerviosa.",
    "voice": "L"
  },
  {
    "id": "E01",
    "voice": "J",
    "text": "Hola, me llamo Leo. Tengo catorce años. Mi cumpleaños es el catorce de septiembre. Soy tranquilo y llevo gafas. Hasta luego."
  },
  {
    "id": "E02a",
    "voice": "L",
    "text": "Hola, Hugo. ¿Cuándo es tu cumpleaños?"
  },
  {
    "id": "E02b",
    "voice": "J",
    "text": "Mi cumpleaños es el treinta de mayo. ¿Y el tuyo?"
  },
  {
    "id": "E02c",
    "voice": "L",
    "text": "El veintitrés de mayo. Para la ficha: soy simpática y tengo el pelo corto."
  },
  {
    "id": "E02d",
    "voice": "J",
    "text": "Yo soy tímido y llevo gafas."
  },
